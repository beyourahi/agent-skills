# OS
.DS_Store

# Python bytecode and test caches from the bundled helpers
__pycache__/
*.pyc
.pytest_cache/

# graft's local graph cache — regenerable, not committed.
**/graft/.cache/

# Local environment and secrets
.env
.env.*
!.env.example
.dev.vars

# Local skill run state (normally kept outside the repository)
**/.local-state/
*.log
